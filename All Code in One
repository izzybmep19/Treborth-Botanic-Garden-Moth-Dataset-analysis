#####Wind speed and direction########
wind_df <- SpAbLine %>%
  dplyr::select(Year, Wind_D, Wind_S, Abundance) %>%
  dplyr::filter(
    !is.na(Year),
    !is.na(Wind_D),
    !is.na(Wind_S),
    !is.na(Abundance)
  )


dir_levels <- c(
  "N", "NNE", "NE", "ENE",
  "E", "ESE", "SE", "SSE",
  "S", "SSW", "SW", "WSW",
  "W", "WNW", "NW", "NNW"
)

wind_df <- wind_df %>%
  mutate(
    Wind_D = ifelse(Wind_D == 360, 0, Wind_D),
    wind_dir = cut(
      Wind_D,
      breaks = seq(0, 360, by = 22.5),
      include.lowest = TRUE,
      right = FALSE,
      labels = dir_levels
    )
  ) %>%
  filter(!is.na(wind_dir))


wind_df <- wind_df %>%
  mutate(
    wind_speed_bin = cut(
      Wind_S,
      breaks = c(0, 2, 5, 8, 12, Inf),
      labels = c("0ÔÇô2", "2ÔÇô5", "5ÔÇô8", "8ÔÇô12", "12+"),
      include.lowest = TRUE
    )
  )

wind_sum_all <- wind_df %>%
  group_by(wind_dir, wind_speed_bin) %>%
  summarise(
    total_Abun = mean(Abundance),
    .groups = "drop"
  )

## Ensure correct direction order
wind_sum_all$wind_dir <- factor(
  wind_sum_all$wind_dir,
  levels = dir_levels
)

## Ensure all directions exist (even zero-count)
wind_sum_all <- wind_sum_all %>%
  tidyr::complete(
    wind_dir,
    wind_speed_bin,
    fill = list(total_Abun = 0)
  )

WindAbun = ggplot(
  wind_sum_all,
  aes(
    x = wind_dir,
    y = total_Abun,
    fill = wind_speed_bin
  )
) +
  geom_col(width = 1, color = "white", linewidth = 0.2) +
  coord_polar(start = -pi/16) +
  scale_x_discrete(drop = FALSE) +
  scale_y_continuous(
    breaks = scales::pretty_breaks(n = 5),
    labels = scales::number_format(accuracy = 0.01)
  ) +
  scale_fill_viridis_d(name = "Wind speed") +
  labs(
    title = "Wind Rose (All Years)",
    y = "Total abundance"
  ) +
  theme_minimal() +
  theme(
    axis.title.x = element_blank(),
    panel.grid.minor = element_blank(),
    legend.position = "bottom"
  )
print(WindAbun)
